#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

echo "==> standardrb (lint)"
bundle exec standardrb

# The gems ship Sorbet signatures under rbi/. This checks that they agree
# with the code in lib/ (the SDK's and each provider gem's). What it covers,
# and the known errors in generated files that it leaves out, is in
# sorbet/config. SRB_SKIP_GEM_RBIS keeps the signatures that other gems in
# the bundle ship out of the check, so their mistakes cannot fail it.
echo "==> srb tc (type check)"
SRB_SKIP_GEM_RBIS=1 bundle exec srb tc

echo "==> rake test"
bundle exec rake test

# Each workload identity provider gem is released on its own, so each is
# linted and tested on its own, with its own bundle and without the SDK.
for gem_dir in gems/*/; do
  echo "==> ${gem_dir%/}: standardrb (lint) + rake test"
  (
    cd "$gem_dir"
    # Never the root bundle, even when this script itself runs under one.
    export BUNDLE_GEMFILE="$PWD/Gemfile"
    bundle check > /dev/null 2>&1 || bundle install --quiet
    bundle exec standardrb
    bundle exec rake test
  )
done

echo "==> All checks passed."
